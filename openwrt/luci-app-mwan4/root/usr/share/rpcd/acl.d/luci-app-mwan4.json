{
	"luci-app-mwan4": {
		"description": "Grant access to MWAN4 configuration and status",
		"read": {
			"uci": [ "mwan4", "network" ],
			"file": {
				"/tmp/mwan4_status.json": [ "read" ],
				"/sys/class/net/*": [ "read", "list" ]
			},
			"ubus": {
				"service": [ "list" ],
				"file": [ "read" ]
			}
		},
		"write": {
			"uci": [ "mwan4" ]
		}
	}
}
