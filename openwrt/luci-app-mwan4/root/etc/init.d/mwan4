#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/mwan4
CONF_FILE=/etc/config/mwan4

start_service() {
	[ -x "$PROG" ] || {
		logger -t mwan4 "Binary $PROG not executable or not installed"
		return 1
	}
	[ -f "$CONF_FILE" ] || {
		logger -t mwan4 "Config $CONF_FILE not found, refusing to start"
		return 1
	}

	config_load mwan4
	local enabled
	config_get_bool enabled global enabled 1
	[ "$enabled" -eq 1 ] || {
		logger -t mwan4 "mwan4 is disabled in $CONF_FILE"
		return 0
	}

	# 启动前先通过内置 UCI 解析器做一次配置校验，避免错误配置进入 procd 重启循环
	if ! "$PROG" --check-config "$CONF_FILE"; then
		logger -t mwan4 "Config $CONF_FILE failed --check-config, aborting start"
		return 1
	fi

	procd_open_instance
	procd_set_param command "$PROG" -c "$CONF_FILE"
	procd_set_param limits nofile="4096 8192"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file "$CONF_FILE"
	procd_close_instance
	logger -t mwan4 "mwan4 service started directly from UCI $CONF_FILE"
}

service_triggers() {
	procd_add_reload_trigger "mwan4" "network"
}
