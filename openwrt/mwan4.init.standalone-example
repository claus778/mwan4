#!/bin/sh /etc/rc.common
#
# ─────────────────────────────────────────────────────────────────────────────
# MWAN4 standalone init（純 JSON 設定，不經 UCI）
#
# 注意：這「不是」套件安裝的 /etc/init.d/mwan4！
#   套件（apk / ipk）安裝的是 openwrt/luci-app-mwan4/root/etc/init.d/mwan4，
#   那支會讀 /etc/config/mwan4（UCI）並產生 /var/etc/mwan4.json。
#
# 本檔僅供「不使用 LuCI / UCI、直接用 JSON 設定」的部署方式參考，
# 例如手動放到 /etc/init.d/ 並搭配 /etc/mwan4/mwan4.json。
# 之所以改名脫離 mwan4.init，就是為了避免與套件內同名腳本互相覆蓋。
#
# 安裝方式：
#   cp mwan4.init.standalone-example /etc/init.d/mwan4
#   chmod +x /etc/init.d/mwan4
#   /etc/init.d/mwan4 enable && /etc/init.d/mwan4 start
# ─────────────────────────────────────────────────────────────────────────────

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/mwan4
CONFIG=/etc/mwan4/mwan4.json

start_service() {
    [ -f "$CONFIG" ] || {
        logger -t mwan4 "Configuration file $CONFIG not found, refusing to start"
        return 1
    }

    [ -x "$PROG" ] || {
        logger -t mwan4 "Binary $PROG not executable or not installed"
        return 1
    }

    # 先驗證設定再交給 procd；設定錯誤時留下明確日誌並拒絕啟動，
    # 避免 daemon 一啟動就退出、被 procd 無限重啟。
    if ! "$PROG" --check-config "$CONFIG"; then
        logger -t mwan4 "Configuration $CONFIG failed --check-config, not starting"
        return 1
    fi

    procd_open_instance
    procd_set_param command "$PROG" -c "$CONFIG"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits core="unlimited"
    procd_set_param file "$CONFIG"
    procd_close_instance
}

stop_service() {
    return 0
}
