#!/bin/sh /etc/rc.common
#
# ─────────────────────────────────────────────────────────────────────────────
# MWAN4 standalone init（纯 JSON 设定，不经 UCI）
#
# 注意：这「不是」套件安装的 /etc/init.d/mwan4！
#   套件（apk / ipk）安装的是 openwrt/luci-app-mwan4/root/etc/init.d/mwan4，
#   那支会读 /etc/config/mwan4（UCI）并产生 /var/etc/mwan4.json。
#
# 本档仅供「不使用 LuCI / UCI、直接用 JSON 设定」的部署方式参考，
# 例如手动放到 /etc/init.d/ 并搭配 /etc/mwan4/mwan4.json。
# 之所以改名脱离 mwan4.init，就是为了避免与套件内同名脚本互相覆盖。
#
# 安装方式：
#   cp mwan4.init.standalone-example /etc/init.d/mwan4
#   chmod +x /etc/init.d/mwan4
#   /etc/init.d/mwan4 enable && /etc/init.d/mwan4 start
# ─────────────────────────────────────────────────────────────────────────────

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/mwan4
CONFIG=/etc/mwan4/mwan4.json

start_service() {
    [ -f "$CONFIG" ] || {
        logger -t mwan4 "Configuration file $CONFIG not found, refusing to start"
        return 1
    }

    [ -x "$PROG" ] || {
        logger -t mwan4 "Binary $PROG not executable or not installed"
        return 1
    }

    # 先验证设定再交给 procd；设定错误时留下明确日志并拒绝启动，
    # 避免 daemon 一启动就退出、被 procd 无限重启。
    if ! "$PROG" --check-config "$CONFIG"; then
        logger -t mwan4 "Configuration $CONFIG failed --check-config, not starting"
        return 1
    fi

    procd_open_instance
    procd_set_param command "$PROG" -c "$CONFIG"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits core="unlimited"
    procd_set_param file "$CONFIG"
    procd_close_instance
}

stop_service() {
    return 0
}
