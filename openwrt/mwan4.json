{
  "check_interval_ms": 500,
  "probe_timeout_ms": 400,
  "window_size": 10,
  "loss_threshold_down": 0.5,
  "loss_threshold_up": 0.1,
  "degrade_loss_threshold": 0.2,
  "degrade_hysteresis": 0.1,
  "degrade_exit_samples": 6,
  "degrade_enter_samples": 20,
  "degrade_min_out_samples": 20,
  "consecutive_fail_down": 3,
  "recovery_success_count": 5,
  "max_rtt_ms": 1500.0,
  "flush_conntrack_on_down": true,
  "flush_conntrack_on_switch": true,
  "route_priority": 0,
  "remove_routes_on_exit": false,
  "ecmp_mode": "auto",
  "_multipath_hash_policy_comment": "l3 = 只哈希 IP（同一个 CDN IP 的多条连线全挤一条 WAN）；l4 = 加上埠，按连线分散（预设；实测同一个目的 IP、只差来源埠的 24 条连线在 l3 下 24/24 走同一条、l4 下 12/12 分开）；inner 只对封装流量有用。空值/null = 不写入、沿用系统预设（＝l3 粒度）。",
  "multipath_hash_policy": "l4",
  "_capacity_proportional_comment": "每条 interface 都设定 max_mbps 时，ECMP 基准权重自动 ∝ max_mbps（容量比例分流）",
  "_load_aware_comment": "true 时在容量比例的基准上，再依实测速率 vs max_mbps/up_mbps 把过载线的权重下修、让部分 flow 转到空闲线；启用时每条 interface 都必须填 max_mbps",
  "load_aware": false,
  "load_target_ratio": 0.8,
  "load_recover_ratio": 0.6,
  "allow_dynamic_weights_on_standard": false,
  "interfaces": [
    {
      "name": "wan1",
      "gateway": "192.168.1.1",
      "metric": 1,
      "weight": 1,
      "max_mbps": 1000,
      "up_mbps": 100,
      "probe_targets": [
        "223.5.5.5:53",
        "114.114.114.114:53"
      ]
    },
    {
      "name": "wan2",
      "gateway": "192.168.2.1",
      "metric": 1,
      "weight": 1,
      "max_mbps": 500,
      "up_mbps": 50,
      "probe_targets": [
        "223.5.5.5:53",
        "114.114.114.114:53"
      ]
    }
  ]
}
