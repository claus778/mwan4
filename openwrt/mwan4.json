{
  "check_interval_ms": 500,
  "probe_timeout_ms": 400,
  "window_size": 10,
  "loss_threshold_down": 0.5,
  "loss_threshold_up": 0.1,
  "degrade_loss_threshold":0.2,"degrade_hysteresis":0.1,"degrade_exit_samples":6,
  "consecutive_fail_down": 3,
  "recovery_success_count": 5,
  "max_rtt_ms": 1500.0,
  "flush_conntrack_on_down": true,
  "flush_conntrack_on_switch": true,
  "route_priority": 0,
  "remove_routes_on_exit": false,
  "ecmp_mode": "standard",
  "_capacity_proportional_comment": "每條 interface 都設定 max_mbps 時，ECMP 基準權重自動 ∝ max_mbps（容量比例分流）",
  "_load_aware_comment": "true 時在容量比例的基準上，再依實測速率 vs max_mbps/up_mbps 把過載線的權重下修、讓部分 flow 轉到空閒線；啟用時每條 interface 都必須填 max_mbps",
  "load_aware": false,
  "load_target_ratio": 0.8,
  "load_recover_ratio": 0.6,
