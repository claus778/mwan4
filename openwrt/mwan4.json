    {
      "name": "wan1",
      "gateway": "192.168.1.1",
      "metric": 1,
      "weight": 1,
      "max_mbps": 1000,
      "up_mbps": 100,
      "probe_targets": [
        "223.5.5.5:53",
        "114.114.114.114:53"
      ]
    },
    {
      "name": "wan2",
      "gateway": "192.168.2.1",
      "metric": 1,
      "weight": 1,
