/target

# 開發機專用的 cargo registry 代理設定，絕不可提交（會讓 CI/其他機器走不通網路）
/.cargo/

# 打包輸出的簽名私鑰：絕不可提交（公鑰 dist/packages/mwan4.rsa.pub 需入庫以供裝置驗簽）
/dist/keys/
*.rsa.key

# 本機除錯日誌
*.log

# 本機臨時下載的 OpenWrt 依賴包與索引，非原始碼
/*.apk
/apkindex.tar.gz

# 打包產物：dist 下僅保留 install.sh 與 packages/mwan4.rsa.pub
/dist/bin/
/dist/packages/*.ipk
/dist/packages/*.apk
/dist/*.tar.gz

# Python 快取
__pycache__/
*.pyc

# WorkBuddy 工作區資料（會話記憶等）
/.workbuddy/

# 本機一次性調試腳本與記錄
/.deploy/
