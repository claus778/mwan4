/target

# 开发机专用的 cargo registry 代理设定，绝不可提交（会让 CI/其他机器走不通网路）
/.cargo/

# 打包输出的签名私钥：绝不可提交（公钥 dist/packages/mwan4.rsa.pub 需入库以供装置验签）
/dist/keys/
*.rsa.key

# 本机除错日志
*.log

# 本机临时下载的 OpenWrt 依赖包与索引，非原始码
/*.apk
/apkindex.tar.gz

# 打包产物：dist 下仅保留 install.sh 与 packages/mwan4.rsa.pub
/dist/bin/
/dist/packages/*.ipk
/dist/packages/*.apk
/dist/*.tar.gz

# Python 快取
__pycache__/
*.pyc

# WorkBuddy 工作区资料（会话记忆等）
/.workbuddy/

# 本机一次性调试脚本与记录
/.deploy/
